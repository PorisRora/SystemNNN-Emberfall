# Publish the buildable project. Local builds, research, reference checkouts
# and game installations stay outside the tracked tree.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY_NOTICES.md
!/LICENSE
!/LICENSE.*
!/core/
!/platform/
!/assets/

/core/PROVENANCE.json
/platform/scene/PROVENANCE.json

# Historical Android probes depend on private research inputs.
/platform/android/build.py
/platform/android/test_native_bridge.py
/platform/android/test_native_events.py
/platform/android/test_text_codec.py
/platform/android/native/
/platform/android/tests/EventProbe.cpp
/platform/android/tests/TextCodecDeviceTest.java
/platform/android/app/*
!/platform/android/app/java/
!/platform/android/app/assets/
/platform/android/app/java/com/tyranor/runtime/systemnnn/*
!/platform/android/app/java/com/tyranor/runtime/systemnnn/SjisTunnelDecoder.java
/platform/android/app/assets/*
!/platform/android/app/assets/licenses/

# Generated files and machine-local credentials.
__pycache__/
.gradle/
.idea/
CMakeFiles/
CMakeCache.txt
*.py[cod]
*.class
*.o
*.obj
*.a
*.so
*.dll
*.exe
*.apk
*.dex
*.log
*.tmp
*.partial
Thumbs.db
.DS_Store
*.sav
*.sav.bak
*.resume
*.thumb
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
.env
.env.*
local.properties
keystore.properties
